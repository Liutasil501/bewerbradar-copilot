# ===== App =====
APP_NAME=JadeAI
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GTM_ID="GTM-55XL7PR4"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-6XRD25H13C"

# Optional: Server-side Gemini API Key for Premium users
GEMINI_API_KEY=""

# Optional server-funded AI burst guard. Defaults: 20 requests per 60 seconds.
AI_SERVER_RATE_LIMIT_MAX_REQUESTS=20
AI_SERVER_RATE_LIMIT_WINDOW_MS=60000

# Public health returns 503 below this free-space threshold on SQLite storage.
HEALTH_MIN_FREE_DISK_MB=10240

# ===== Stripe Billing =====
# Use test keys locally and live keys only in the protected production environment.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_YEARLY=""
STRIPE_PRICE_ID_PREMIUM_MONTHLY=""
STRIPE_PRICE_ID_PREMIUM_YEARLY=""
STRIPE_PORTAL_CONFIGURATION_ID=""

# Keep both false until Stripe collecting registrations and product tax codes
# have been verified in Live mode. Checkout fails closed on partial activation.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TAX_CONFIGURATION_CONFIRMED=false

# Enable only after the public Terms of Service URL is saved in the Stripe
# Dashboard. Stripe rejects Checkout sessions if this is enabled too early.
STRIPE_TERMS_OF_SERVICE_CONFIGURED=false

# Optional first-month coupon for monthly subscriptions.
STRIPE_COUPON_FIRST_MONTH=""

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# Local UI QA only. The harness also requires NODE_ENV=development,
# fingerprint auth and SQLite, and remains unavailable in production.
QA_HARNESS_ENABLED=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Database =====
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/jadeai

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/jade.db

# ===== i18n =====
DEFAULT_LOCALE=de
