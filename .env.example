# ===== App =====
APP_NAME=JadeAI
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GTM_ID="GTM-55XL7PR4"

# Optional: Server-side Gemini API Key for Premium users
GEMINI_API_KEY=""

# ===== Stripe Billing =====
# Use test keys locally and live keys only in the protected production environment.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_YEARLY=""
STRIPE_PRICE_ID_PREMIUM_MONTHLY=""
STRIPE_PRICE_ID_PREMIUM_YEARLY=""
STRIPE_PORTAL_CONFIGURATION_ID=""

# Optional first-month coupon for monthly subscriptions.
STRIPE_COUPON_FIRST_MONTH=""

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# Local UI QA only. The harness also requires NODE_ENV=development,
# fingerprint auth and SQLite, and remains unavailable in production.
QA_HARNESS_ENABLED=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Database =====
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/jadeai

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/jade.db

# ===== i18n =====
DEFAULT_LOCALE=de
